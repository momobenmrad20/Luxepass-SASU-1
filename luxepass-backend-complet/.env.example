# ── Serveur ──
PORT=4000
NODE_ENV=development

# ── Base de données (Prisma / Supabase Postgres) ──
# Dans Supabase : Project Settings > Database > Connection string.
# 1) DATABASE_URL = "Transaction pooler" (port 6543) — utilisée par l'app :
#    postgresql://postgres.<ref>:<password>@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
# 2) DIRECT_URL = connexion directe (port 5432) — utilisée uniquement par
#    `prisma migrate` (le pooler ne supporte pas les migrations) :
#    postgresql://postgres.<ref>:<password>@<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=
DIRECT_URL=

# ── JWT ──
# Secret pour les tokens d'accès staff (courte durée)
JWT_ACCESS_SECRET=change-moi-en-production-access
# Secret pour les refresh tokens (longue durée)
JWT_REFRESH_SECRET=change-moi-en-production-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ── Session de check-in ──
# Secret séparé pour les sessionToken (distincts des JWT staff)
CHECKIN_SESSION_SECRET=change-moi-en-production-checkin
CHECKIN_SESSION_TTL=2h

# ── Token de streaming SSE (live-feed PMS) ──
# Secret séparé, TTL très court : sert uniquement à ouvrir la connexion
# EventSource (qui ne peut pas porter de header Authorization), pas à
# autoriser des actions REST. Cf. docs/tasks/REALTIME_FEED.md §2.
STREAM_SESSION_SECRET=change-moi-en-production-stream
STREAM_SESSION_TTL=60s

# ── Token du pass QR (HMAC, cf. utils/qrToken.ts) ──
# Secret dédié, distinct des autres — sert à signer/vérifier le token
# encodé dans le QR du pass de séjour (qr-verify).
QR_PASS_SECRET=change-moi-en-production-qrpass

# ── Token de séjour (stayToken, PHASE 0 / ACTION 1) ──
# JWT HS256 remis au client à la fin du check-in ; exigé en `Authorization:
# Bearer` sur TOUTES les routes /stays/:stayId/*. Secret DÉDIÉ, distinct des
# autres. En production : obligatoire, 32 caractères minimum, différent des
# autres secrets — sinon le serveur refuse de démarrer.
# Générer : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
STAY_JWT_SECRET=change-moi-en-production-stay
# Durée de vie = fin du jour de départ + STAY_TOKEN_GRACE_HOURS ; si le séjour
# n'a pas de date de départ exploitable : STAY_TOKEN_DEFAULT_TTL.
STAY_TOKEN_DEFAULT_TTL=7d
STAY_TOKEN_GRACE_HOURS=12
# Plafond absolu, ancré sur la création du séjour (createdAt), appliqué à
# CHAQUE émission/renouvellement du stayToken (avec ou sans date de départ).
# Empêche un token intercepté d'être renouvelé indéfiniment via GET /pass.
STAY_TOKEN_ABSOLUTE_MAX_DAYS=30

# ── CORS ──
# Liste d'origines séparées par des virgules (une seule valeur reste valide) :
# CORS_ORIGIN=http://localhost:5173,https://app.ocean-a-suites.tn
CORS_ORIGIN=http://localhost:3000

# ── Reverse proxy ──
# Nombre de proxies devant le backend (0 en local). À régler en production
# derrière Nginx/Render/Fly… sinon le rate limiting voit une seule IP.
TRUST_PROXY_HOPS=0

# ── Uploads (scan pièce d'identité) ──
MAX_UPLOAD_MB=8

# ── IA Concierge (Phase 1) ──
# Clé API Anthropic (console.anthropic.com) — sans elle, le concierge
# IA bascule automatiquement en mode dégradé (transmission simple à
# l'équipe, comme avant Phase 1) plutôt que de planter.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Optionnel : modèle dédié à l'OCR de pièce d'identité (ocr.service.ts).
# Replié sur ANTHROPIC_MODEL si absent.
ANTHROPIC_OCR_MODEL=

# ── Paiement en ligne (Stripe PaymentIntents) ──
# Aucune donnée de carte ne transite par ce backend : le navigateur parle
# directement à Stripe (Stripe Elements). Le backend ne détient que ces DEUX
# secrets — JAMAIS dans le dépôt, JAMAIS côté frontend, JAMAIS dans les logs.
#
# STRIPE_SECRET_KEY : Dashboard Stripe > Développeurs > Clés API.
#   sk_test_… en développement, sk_live_… en production (ou clé restreinte rk_…
#   limitée aux « PaymentIntents » en écriture et « Charges » en lecture).
#   ⚠️ La clé PUBLIQUE pk_… va dans le frontend, pas ici (refusée au démarrage).
STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET : secret de SIGNATURE de l'endpoint webhook (whsec_…),
#   distinct de la clé API. Un secret par endpoint et par mode (test/live).
#   - Dev local : `stripe listen --forward-to localhost:4000/payments/webhook`
#     affiche le whsec_… à utiliser (Stripe CLI à lancer sur un PC ; sur Termux,
#     exposer le backend via un tunnel et déclarer l'URL dans le Dashboard).
#   - Prod : Dashboard > Développeurs > Webhooks > Ajouter un endpoint
#     https://<votre-domaine>/payments/webhook, événements à cocher :
#     payment_intent.succeeded et payment_intent.payment_failed.
STRIPE_WEBHOOK_SECRET=
# Devise unique de l'établissement (ISO 4217). Le montant débité est TOUJOURS
# calculé dans cette devise, quelle que soit celle annoncée par le client.
# ⚠️ tnd = 3 décimales (1 DT = 1000 millimes) : géré par utils/money.ts.
PAYMENT_CURRENCY=tnd
# En production, les deux clés ci-dessus sont OBLIGATOIRES : le serveur refuse
# de démarrer si l'une manque ou n'a pas le bon format. Hors production, leur
# absence désactive simplement /payments/* (503 payments_disabled).
